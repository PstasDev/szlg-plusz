DEBUG=False
SECRET_KEY=replace-with-a-unique-random-value-of-at-least-50-characters
ALLOWED_HOSTS=sso.szlg.info

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=

WEBAUTHN_RP_ID=sso.szlg.info
WEBAUTHN_RP_NAME=SZLG+
WEBAUTHN_ORIGINS=https://sso.szlg.info

# Enable for local OAuth clients that use dynamic localhost ports.
ALLOW_LOCALHOST_LOOPBACK=False

# Public issuer URL (discovery "issuer" and ID token "iss"). Must be the https URL clients use.
# Defaults to https://<first ALLOWED_HOSTS entry>/o when DEBUG=False.
OIDC_ISSUER=https://sso.szlg.info/o

# Create this private signing key once; never commit it or send it to clients.
OIDC_RSA_PRIVATE_KEY_FILE=.secrets/oidc-private.pem

# Enable these behind HTTPS in production.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
CSRF_TRUSTED_ORIGINS=https://sso.szlg.info
# Set true only when TLS is terminated by a trusted reverse proxy.
USE_X_FORWARDED_PROTO=True

# Password reset e-mails. In development (DEBUG=True) they are printed to the console.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SZLG+ <noreply@sso.szlg.info>
